{
  "name": "rimdocplus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Diagnose, repair, and supervise a modded RimWorld install.",
  "keywords": [
    "rimworld",
    "mod-manager",
    "diagnostics",
    "tauri",
    "desktop"
  ],
  "author": "w1ck3ds0d4 <daniel.svs@outlook.com>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/w1ck3ds0d4/RimDocPlus",
  "repository": {
    "type": "git",
    "url": "https://github.com/w1ck3ds0d4/RimDocPlus"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "scan": "node scripts/scan.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "workshop": "node scripts/workshop.mjs",
    "verify": "tsc --noEmit && vitest run && prettier --check .",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "probe:verify": "node scripts/probe-verify.mjs",
    "probe:build": "dotnet publish sidecar/PatchProbe -c Release -r win-x64",
    "probe:test": "dotnet test sidecar/PatchProbe.Tests -c Release",
    "probe:stage": "node scripts/probe-stage.mjs",
    "probe-mod:build": "dotnet build sidecar/CompanionMod -c Release",
    "probe-mod:stage": "node scripts/probe-mod-stage.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
